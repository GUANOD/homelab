---
# Copy to secrets.yml (gitignored) and fill in.

# Jellyfin admin, created by the playbook through the startup wizard API (no wizard in the browser)
jellyfin_admin_user: "admin"
jellyfin_admin_password: "change-me-please"

# Libraries: folder inside the OMV media share (mounted at /media) → Jellyfin library type
# (movies, tvshows, music, musicvideos, homevideos, books, mixed). Only missing libraries are
# added; renaming/removing one here doesn't change Jellyfin.
jellyfin_libraries:
  - { name: Movies, type: movies, folder: Movies }
  - { name: Shows, type: tvshows, folder: Shows }

# Optional: metadata language/country (defaults en / US)
# jellyfin_metadata_language: en
# jellyfin_metadata_country: US
