---
# Copy to secrets.yml (gitignored) and fill in.

# Required: Portainer admin password, set at first start (min. 12 characters)
portainer_admin_password: "change-me-please"

# Optional: each Homepage stats widget is enabled only when its credentials are set.
# Proxmox needs nothing here: Terraform creates a read-only token (vars/tf_gen.yml).

# AdGuard Home web UI login
# homepage_adguard_username: ""
# homepage_adguard_password: ""

# OpenMediaVault: a dedicated low-privilege OMV user is best
# homepage_omv_username: ""
# homepage_omv_password: ""

# Home Assistant: Profile → Security → Long-lived access tokens
# homepage_hass_token: ""

# Portainer: My account → Access tokens (after first login); env = environment ID from the URL (#!/<id>/docker)
# homepage_portainer_api_key: ""
# homepage_portainer_env: 3

# Jellyfin: Dashboard → API Keys → +
# homepage_jellyfin_key: ""
