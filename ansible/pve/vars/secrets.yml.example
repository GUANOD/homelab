---
# Copy to secrets.yml (gitignored) and fill in.

# OMV SMB share with the media, mounted on pve1 as storage "jellyfinmedia" and bind-mounted into
# the Jellyfin container. The OMV user needs read/write on that share (OMV → Shared folders → Privileges).
omv_media_share: "JELLYFINMEDIA"
omv_media_username: "jellyfin"
omv_media_password: "change-me-please"
