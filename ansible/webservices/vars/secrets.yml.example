---
# Copy to secrets.yml (gitignored) and fill in.

# Cloudflare API token for Caddy's DNS-01 challenge: scoped token, Zone:DNS:Edit on your zone only
cloudflare_api_token: ""
# ACME account email for Let's Encrypt
caddy_email: ""

# Public domain served by Caddy (sites are <name>.<domain>)
domain: ""

# LAN DNS: domain + reverse zone AdGuard forwards to your router
private_domain: ""
reverse_domain: ""

# AdGuard Home: admin login hash (htpasswd -B -C 10 -n -b <user> '<password>', part after "user:")
adguard_password_hash: ""
adguard_domain: ""

# Backends proxied by Caddy (hostnames or IPs). The Docker host address comes from Terraform (tf_gen.yml).
webservices_address: ""
hass_address: ""
