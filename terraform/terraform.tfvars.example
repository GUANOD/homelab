# Copy to terraform.tfvars (gitignored) and fill in. Example addresses are placeholders.

# Proxmox API
pm_api_url          = "https://192.168.1.10:8006/api2/json"
pm_api_token_id     = "terraform@pve!terraform"
pm_api_token_secret = ""
# root@pam password: only for what PVE refuses to tokens (Jellyfin LXC iGPU passthrough + bind mount)
pve_root_password = ""

# Network
network_gateway = "192.168.1.1"

# webservices LXC (AdGuard Home + Caddy)
webservices_address        = "192.168.1.2/24"
webservices_datastore      = "local-lvm"
webservices_datastoresize  = "16"
webservices_password       = "" # container root password (SSH uses a generated key)
webservices_admin_user     = "admin"
webservices_admin_password = ""

# OpenMediaVault VM
omv_address    = "192.168.1.3/24"
omv_admin_user = "admin"
omv_password   = ""
omv_passthrough_disks = [
  # { id = "/dev/disk/by-id/ata-<model>_<serial>-part1", size = 3725 },
]

# User on the Proxmox host for disk passthrough over SSH
privileged_user    = "root"
privileged_user_pw = ""

# Proxmox storage on the OMV "backups" SMB share
omv_backups_user     = ""
omv_backups_password = ""

# Docker host VM (Portainer, Homepage)
docker_address = "192.168.1.4/24"

# Jellyfin LXC
jellyfin_address = "192.168.1.15/24"

# Optional overrides (defaults in variables.tf)
# pve_ssh_private_key_path = "~/.ssh/pve"
# docker_vm_id             = 104
# jellyfin_ct_id           = 105
# backup_retention         = { daily = 7, weekly = 4, monthly = 3 }
